// use prisma-next

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  documents Document[]
  createdAt Timestamptz(6) @default(now())
  updatedAt temporal.updatedAt()
}

model InviteCode {
  id        String   @id @default(uuid())
  code      String   @unique
  isUsed    Boolean  @default(false)
  usedById  String?  @unique
  createdAt Timestamptz(6) @default(now())
  updatedAt temporal.updatedAt()
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id        String         @id @default(uuid())
  title     String
  url       String?
  hash      String         @unique
  size      Int
  mimeType  String
  status    DocumentStatus @default(PENDING)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  createdAt Timestamptz(6) @default(now())
  updatedAt temporal.updatedAt()
}
